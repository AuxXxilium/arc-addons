# Match USB network cards only. SUBSYSTEMS=="usb" walks the parent chain, so a
# USB NIC matches whichever name it enumerated under and the script's own case
# handles eth/usb/wlan from there. Without it the rule also matched every PCIe
# NIC, and the script then fired /etc/rc.network per interface from udev, which
# raced the eth* renaming done by the sortnetif addon.
ACTION=="add|remove", SUBSYSTEM=="net", SUBSYSTEMS=="usb", RUN+="/usr/lib/udev/script/usb-netcard.sh %E{ACTION} %k"
